<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IA Concursos - Simulador Seguro (Custo Zero)</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/4.1.0/crypto-js.min.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        
        .container {
            width: 100%;
            max-width: 700px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            overflow: hidden;
        }
        
        .header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 30px;
            text-align: center;
        }
        
        .header h1 {
            font-size: 28px;
            margin-bottom: 5px;
        }
        
        .header p {
            font-size: 12px;
            opacity: 0.9;
        }
        
        .content {
            padding: 40px;
        }
        
        .auth-panel {
            display: block;
        }
        
        .simulator-panel {
            display: none;
        }
        
        .form-group {
            margin-bottom: 20px;
        }
        
        label {
            display: block;
            font-weight: 600;
            color: #333;
            margin-bottom: 8px;
            font-size: 14px;
        }
        
        input,
        select {
            width: 100%;
            padding: 12px;
            border: 2px solid #e0e0e0;
            border-radius: 6px;
            font-size: 14px;
            transition: border-color 0.3s;
        }
        
        input:focus,
        select:focus {
            outline: none;
            border-color: #667eea;
        }
        
        button {
            width: 100%;
            padding: 12px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
            margin-top: 10px;
        }
        
        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
        }
        
        .toggle-link {
            text-align: center;
            margin-top: 20px;
            color: #667eea;
            cursor: pointer;
            font-size: 14px;
            text-decoration: underline;
        }
        
        .toggle-link:hover {
            color: #764ba2;
        }
        
        .hidden-group {
            display: none;
        }
        
        .question-display {
            margin-top: 30px;
            padding: 20px;
            background: #f8f9fa;
            border-radius: 8px;
            display: none;
        }
        
        .question-text {
            font-size: 18px;
            font-weight: 500;
            color: #333;
            margin-bottom: 20px;
            line-height: 1.6;
        }
        
        .alternative {
            background: white;
            padding: 15px;
            margin-bottom: 12px;
            border-radius: 6px;
            border: 2px solid #e0e0e0;
            cursor: pointer;
            transition: all 0.2s;
        }
        
        .alternative:hover {
            border-color: #667eea;
            background: #f0f4ff;
        }
        
        .feedback {
            margin-top: 20px;
            padding: 20px;
            border-radius: 6px;
            display: none;
            line-height: 1.6;
            font-size: 14px;
        }
        
        .feedback.success {
            background: #d4edda;
            color: #155724;
            border: 2px solid #c3e6cb;
        }
        
        .feedback.error {
            background: #f8d7da;
            color: #721c24;
            border: 2px solid #f5c6cb;
        }
        
        .next-button {
            display: none;
            margin-top: 20px;
        }
        
        .loading {
            display: none;
            text-align: center;
            padding: 20px;
            color: #667eea;
            font-weight: bold;
        }
        
        .selector-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 20px;
        }
        
        .selector-grid select {
            margin-top: 0;
        }
        
        .stats-bar {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 15px;
            margin-top: 30px;
            padding-top: 20px;
            border-top: 2px solid #e0e0e0;
        }
        
        .stat-item {
            text-align: center;
            padding: 15px;
            background: #f8f9fa;
            border-radius: 6px;
        }
        
        .stat-label {
            font-size: 12px;
            color: #666;
            font-weight: 600;
            margin-bottom: 8px;
        }
        
        .stat-value {
            font-size: 20px;
            font-weight: bold;
            color: #667eea;
        }
        
        .logout-btn {
            background: #ee5253;
            padding: 8px 15px;
            width: auto;
            margin-top: 0;
            margin-left: auto;
            display: block;
            margin-right: 0;
        }
        
        .user-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 2px solid #e0e0e0;
        }
        
        .user-info {
            font-size: 16px;
            font-weight: 600;
            color: #333;
        }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <h1>🎯 IA Concursos</h1>
        <p>Simulador com Ollama + PostgreSQL (Custo Zero)</p>
    </div>
    
    <div class="content">
        <!-- PAINEL DE AUTENTICAÇÃO -->
        <div class="auth-panel" id="authPanel">
            <div class="form-group">
                <label for="authEmail">E-mail</label>
                <input type="email" id="authEmail" placeholder="seu@email.com">
            </div>
            
            <div class="form-group">
                <label for="authSenha">Senha</label>
                <input type="password" id="authSenha" placeholder="Sua senha">
            </div>
            
            <div class="form-group hidden-group" id="authNomeGroup">
                <label for="authNome">Seu Nome</label>
                <input type="text" id="authNome" placeholder="João Silva">
            </div>
            
            <button onclick="executarAcaoPrincipal()">Entrar no Simulador</button>
            <div class="toggle-link" onclick="alternarModo()">Não tem conta? Cadastre-se aqui</div>
        </div>
        
        <!-- PAINEL DO SIMULADOR -->
        <div class="simulator-panel" id="simPanel">
            <div class="user-header">
                <div class="user-info">Bem-vindo, <span id="nomeUsuario"></span></div>
                <button class="logout-btn" onclick="logout()">Sair</button>
            </div>
            
            <div class="selector-grid">
                <div>
                    <label for="simConcurso">Concurso</label>
                    <select id="simConcurso">
                        <option value="PMDF">PMDF (Cebraspe)</option>
                        <option value="STT">STT (Exército)</option>
                    </select>
                </div>
                <div>
                    <label for="simMateria">Matéria</label>
                    <select id="simMateria">
                        <option value="Português">Português</option>
                        <option value="Direito Penal">Direito Penal</option>
                        <option value="Logística">Logística / Adm</option>
                    </select>
                </div>
            </div>
            
            <label for="simDificuldade">Dificuldade</label>
            <select id="simDificuldade" style="margin-bottom: 20px;">
                <option value="Médio">Médio</option>
                <option value="Fácil">Fácil</option>
                <option value="Difícil">Difícil</option>
            </select>
            
            <button onclick="gerarQuestaoOllama()">Gerar Questão Inédita</button>
            
            <div class="loading" id="statusLoading">
                ⏳ Gemma 2 está elaborando uma questão... Aguarde.
            </div>
            
            <div class="question-display" id="questionDisplay">
                <div class="question-text" id="questionText"></div>
                <div id="alternativesContainer"></div>
                <div class="feedback" id="feedbackBox"></div>
                <button class="next-button" id="nextButton" onclick="gerarQuestaoOllama()">Próxima Questão ➡️</button>
            </div>
            
            <div class="stats-bar">
                <div class="stat-item">
                    <div class="stat-label">Respondidas</div>
                    <div class="stat-value" id="statTotal">0</div>
                </div>
                <div class="stat-item">
                    <div class="stat-label">Taxa de Acertos</div>
                    <div class="stat-value" id="statPercentual">0.00%</div>
                </div>
                <div class="stat-item">
                    <div class="stat-label">Horas Estudadas</div>
                    <div class="stat-value" id="statHoras">0.00h</div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const API = "http://localhost:8000";
    const CHAVE_HMAC = "DIRETRIZ_SEGURANCA_MAXIMA_CONCURSOS_2026";
    let modoCadastro = false;
    let questaoAtual = null;
    let timerHeartbeat = null;

    window.onload = function() {
        if(localStorage.getItem("token_concurso")) {
            mostrarSimulador();
        }
    };

    function alternarModo() {
        modoCadastro = !modoCadastro;
        document.getElementById("authNomeGroup").style.display = modoCadastro ? "block" : "none";
        document.querySelector("button").textContent = modoCadastro ? "Cadastrar" : "Entrar no Simulador";
        document.querySelector(".toggle-link").textContent = modoCadastro ? "Já tem conta? Faça login" : "Não tem conta? Cadastre-se aqui";
    }

    async function executarAcaoPrincipal() {
        const email = document.getElementById("authEmail").value;
        const senha = document.getElementById("authSenha").value;
        const nome = document.getElementById("authNome").value;

        if(!email || !senha || (modoCadastro && !nome)) {
            alert("Preencha todos os campos corretamente.");
            return;
        }

        const rota = modoCadastro ? "/cadastro" : "/login";
        const payload = modoCadastro ? { email, senha, nome } : { email, senha };

        try {
            const res = await fetch(`${API}${rota}`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload)
            });
            const dados = await res.json();

            if (!res.ok) throw new Error(dados.detail || "Erro na operação.");

            if(modoCadastro) {
                alert("Cadastro realizado! Agora faça login.");
                alternarModo();
            } else {
                localStorage.setItem("token_concurso", dados.token);
                localStorage.setItem("email_concurso", dados.email);
                localStorage.setItem("nome_concurso", dados.nome);
                mostrarSimulador();
            }
        } catch (err) {
            alert("Erro: " + err.message);
        }
    }

    function mostrarSimulador() {
        document.getElementById("authPanel").style.display = "none";
        document.getElementById("simPanel").style.display = "block";
        document.getElementById("nomeUsuario").textContent = localStorage.getItem("nome_concurso");
        atualizarEstatisticas();
        
        if(timerHeartbeat) clearInterval(timerHeartbeat);
        timerHeartbeat = setInterval(enviarHeartbeatCriptografado, 60000);
    }

    function logout() {
        if(timerHeartbeat) clearInterval(timerHeartbeat);
        localStorage.clear();
        document.getElementById("simPanel").style.display = "none";
        document.getElementById("authPanel").style.display = "block";
        document.getElementById("authEmail").value = "";
        document.getElementById("authSenha").value = "";
        document.getElementById("authNome").value = "";
    }

    async function enviarHeartbeatCriptografado() {
        const email = localStorage.getItem("email_concurso");
        const token = localStorage.getItem("token_concurso");
        if(!token) return;

        const timestamp = Math.floor(Date.now() / 1000);
        const mensagem = `${email}:${token}:${timestamp}`;
        const assinatura = CryptoJS.HmacSHA256(mensagem, CHAVE_HMAC).toString(CryptoJS.enc.Hex);

        try {
            const res = await fetch(`${API}/registrar-tempo`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ email, token, timestamp, assinatura_criptografica: assinatura })
            });
            const dados = await res.json();
            
            if(res.status === 403 || res.status === 401) {
                alert("Sua sessão foi derrubada. Faça login novamente.");
                logout();
            } else if(res.ok) {
                document.getElementById("statHoras").textContent = dados.total_horas + "h";
            }
        } catch (e) {
            console.log("Heartbeat falhou (offline?)", e);
        }
    }

    async function gerarQuestaoOllama() {
        document.getElementById("statusLoading").style.display = "block";
        document.getElementById("questionDisplay").style.display = "none";
        document.getElementById("feedbackBox").style.display = "none";
        document.getElementById("nextButton").style.display = "none";

        const payload = {
            email: localStorage.getItem("email_concurso"),
            token: localStorage.getItem("token_concurso"),
            concurso: document.getElementById("simConcurso").value,
            materia: document.getElementById("simMateria").value,
            dificuldade: document.getElementById("simDificuldade").value
        };

        try {
            const res = await fetch(`${API}/gerar-questao`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload)
            });
            const dados = await res.json();

            if (!res.ok) throw new Error(dados.detail || "Erro ao gerar questão.");

            questaoAtual = dados;
            document.getElementById("questionText").textContent = dados.enunciado;

            const containerAlt = document.getElementById("alternativesContainer");
            containerAlt.innerHTML = "";

            if(dados.tipo === "Certo/Errado") {
                ["Certo", "Errado"].forEach(opt => {
                    const div = document.createElement("div");
                    div.className = "alternative";
                    div.textContent = opt;
                    div.onclick = () => submeterResposta(opt);
                    containerAlt.appendChild(div);
                });
            } else {
                Object.keys(dados.alternativas).forEach(letra => {
                    const div = document.createElement("div");
                    div.className = "alternative";
                    div.textContent = `${letra}) ${dados.alternativas[letra]}`;
                    div.onclick = () => submeterResposta(letra);
                    containerAlt.appendChild(div);
                });
            }

            document.getElementById("statusLoading").style.display = "none";
            document.getElementById("questionDisplay").style.display = "block";

        } catch (err) {
            document.getElementById("statusLoading").style.display = "none";
            alert("Erro: " + err.message);
        }
    }

    async function submeterResposta(resposta) {
        const alternatives = document.querySelectorAll(".alternative");
        alternatives.forEach(a => a.style.pointerEvents = "none");

        const payload = {
            email: localStorage.getItem("email_concurso"),
            token: localStorage.getItem("token_concurso"),
            questao_id: questaoAtual.id,
            resposta_escolhida: resposta,
            resposta_correta: questaoAtual.resposta_correta
        };

        try {
            const res = await fetch(`${API}/salvar-resposta`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload)
            });
            const dados = await res.json();

            if (!res.ok) throw new Error(dados.detail || "Erro ao salvar resposta.");

            const feedbackBox = document.getElementById("feedbackBox");
            feedbackBox.style.display = "block";

            if(dados.acertou) {
                feedbackBox.className = "feedback success";
                feedbackBox.innerHTML = `<strong>🟢 PARABÉNS, VOCÊ ACERTOU!</strong><br><br><strong>Explicação:</strong> ${questaoAtual.explicacao}<br><br><strong>Pegadinha da Banca:</strong> ${questaoAtual.pegadinha_banca}`;
            } else {
                feedbackBox.className = "feedback error";
                feedbackBox.innerHTML = `<strong>🔴 VOCÊ ERROU.</strong> Gabarito correto: <strong>${questaoAtual.resposta_correta}</strong><br><br><strong>Explicação:</strong> ${questaoAtual.explicacao}<br><br><strong>Pegadinha da Banca:</strong> ${questaoAtual.pegadinha_banca}`;
            }

            document.getElementById("nextButton").style.display = "block";
            atualizarEstatisticas();

        } catch (err) {
            alert("Erro: " + err.message);
        }
    }

    async function atualizarEstatisticas() {
        const email = localStorage.getItem("email_concurso");
        const token = localStorage.getItem("token_concurso");

        try {
            const res = await fetch(`${API}/estatisticas?email=${email}&token=${token}`);
            const dados = await res.json();

            if(res.ok) {
                document.getElementById("statTotal").textContent = dados.total;
                document.getElementById("statPercentual").textContent = dados.percentual;
                document.getElementById("statHoras").textContent = dados.horas_estudadas + "h";
            }
        } catch (e) {
            console.log("Erro ao atualizar estatísticas");
        }
    }
</script>

</body>
</html>
